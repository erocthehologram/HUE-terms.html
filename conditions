    .logo-mark .triangle {
      width: 0;
      height: 0;
      border-left: 38px solid transparent;
      border-right: 38px solid transparent;
      border-bottom: 70px solid var(--cream);
      filter: drop-shadow(0 0 6px rgba(0,0,0,0.6));
    }

    .logo-mark .triangle::before {
      content: "";
      position: absolute;
      inset: 6px;
      border-left: 32px solid transparent;
      border-right: 32px solid transparent;
      border-bottom: 58px solid var(--navy);
    }

    .spectrum {
      position: absolute;
      top: 40px;
      left: 60px;
      width: 150px;
      height: 40px;
      background: linear-gradient(
        to right,
        #1a5f70,
        #2b6f6d,
        #b89a4c,
        #d88b34,
        #c65338,
        #8f3242
      );
      clip-path: polygon(0 45%, 100% 0, 100% 100%, 0 55%);
    }

    .incoming-light {
      position: absolute;
      top: 40px;
      left: -120px;
      width: 120px;
      height: 3px;
      background: var(--cream);
    }

    h1 {
