      color: #e6ddd0;
    }

    ul {
      padding-left: 1.2rem;
    }

    .last-updated {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: #b3a894;
      margin-bottom: 1.5rem;
    }

    a {
      color: var(--gold);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      main {
        margin: 0 1rem 3rem;
        padding: 1.5rem 1.2rem 3rem;
      }
      h1 {
